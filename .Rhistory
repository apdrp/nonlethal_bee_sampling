topic_levels <- tribble(
~topic_code, ~topic_label,                                                   ~group,
1L, "Method development, validation or comparison",                          "Methodological",
2L, "Inventory, monitoring and population status",                           "Ecological / applied",
3L, "Species biology and ecology",                                           "Ecological / applied",
4L, "Habitat, landscape and environmental effects",                          "Ecological / applied",
5L, "Management and conservation interventions",                             "Ecological / applied",
6L, "Plants, floral resources and plant-pollinator interactions",            "Ecological / applied",
7L, "Pollination and pollinator effectiveness",                              "Ecological / applied"
)
## ---- 2. Table de correspondance : fragment de texte -> catégorie -----------
## Les fragments sont en minuscules, comparés au texte normalisé (minuscules +
## espaces simplifiés) avec fixed() : pas de regex, pas de souci de ponctuation.
topic_lookup <- tribble(
~key,                                                      ~topic_code,
# 1. Méthodes
"iot bioacoustic sensors",                                 1L,
"blue vane trap",                                          1L,
"detection probability varied by the presence",            1L,
"within community variation in detection",                 1L,
"mark-recapture as a tool",                                1L,
"low-effort and cost-effective monitoring",                1L,
"visually sample insects",                                 1L,
"10-minute surveys",                                       1L,
"dna metabarcoding and in vivo",                           1L,
"non-lethal rba technique",                                1L,
"volunteers to participate in data collection",            1L,
"how sampling duration",                                   1L,
"lethal and nonlethal methods",                            1L,
"hierarchical distance models",                            1L,
"acoustic monitoring of bee behaviors",                    1L,
"various sampling methods",                                1L,
"partial antennal loss",                                   1L,
"survey effort required",                                  1L,
"hair-based barcoding",                                    1L,
"optimal levels of survey effort",                         1L,
"focal observations and video recordings",                 1L,
"edna and video recordings",                               1L,
"faeces collection",                                       1L,
"collection-based and inat",                               1L,
"all three techniques",                                    1L,
# 2. Inventaire / suivi
"b. affinis and other bombus",                             2L,
"range extension",                                         2L,
"baseline data on species richness",                       2L,
"dominance distribution of pollinators",                   2L,
"extended bloom duration",                                 2L,
"assessing colony abundance",                              2L,
"historical and contemporary occurrence data",             2L,
"bee taxa visiting cucurbita",                             2L,
# 3. Biologie / écologie des espèces
"population-level cognition",                              3L,
"body size spatial structuring",                           3L,
"impact of honeybees on the buff-tailed",                  3L,
"mode of colonization",                                    3L,
"queens of b. pauloensis",                                 3L,
"urban c. collaris",                                       3L,
"worker foraging distance",                                3L,
"population genetics of two bumblebee species",            3L,
"colletes validus",                                        3L,
"engaging in foraging behavior",                           3L,
"predator or competitor",                                  3L,
"s. str. complex",                                         3L,
"foraging behaviour of wild populations of the buff-tailed", 3L,
# 4. Habitat / paysage / environnement
"occupancy across 3 major land use",                       4L,
"habitat quality and land-use on bumble bee survival",     4L,
"community-supported agriculture",                         4L,
"pollinator visits between urban and rural",               4L,
"modifications of plant-pollinator interactions",          4L,
"wild bees foraging at city trees",                        4L,
"honeybee and bumblebee activity to changes in weather",   4L,
"bee abundance and diversity in urban community gardens",  4L,
"regenerating stands",                                     4L,
"effects of crop blooming on native bee",                  4L,
"wild bumble bee colonies in the surrounding landscape",   4L,
"trait-based approach",                                    4L,
"landscape context influences bumble bee density",         4L,
"influence of the landscape at multiple scales",           4L,
"green roofs",                                             4L,
# 5. Gestion / conservation
"targeted agri-environment scheme",                        5L,
"grassland set-asides",                                    5L,
"pollinator friendly surrounding roadsides",               5L,
"integrated pest management",                              5L,
"rare mowing",                                             5L,
"spring burning",                                          5L,
"sites enhanced with plantings of floral resources",       5L,
"native perennial flower strips",                          5L,
"aculeate communities",                                    5L,
"higher level stewardship",                                5L,
# 6. Plantes / ressources florales
"attractiveness between native and alien",                 6L,
"document plant use by bees",                              6L,
"flowering plant species selected by bumble bees",         6L,
"roadside plant communities that establish",               6L,
"visitation rates between cultivated and natural",         6L,
