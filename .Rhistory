)
## ---- 3. Classification des objectifs --------------------------------------
classify_objective <- function(x) {
x <- str_squish(str_to_lower(x))
vapply(x, function(s) {
if (is.na(s)) return(NA_integer_)
hits <- unique(topic_lookup$topic_code[
vapply(topic_lookup$key, function(k) str_detect(s, fixed(k)), logical(1))
])
if (length(hits) > 1) warning("Plusieurs catégories pour : ", s, call. = FALSE)
if (length(hits) == 0) NA_integer_ else hits[1]
}, integer(1), USE.NAMES = FALSE)
}
dataset_unique <- dataset_unique %>%
mutate(topic_code = classify_objective(study_objective))
# Objectifs non classés (à vérifier / compléter dans topic_lookup)
dataset_unique %>%
filter(is.na(topic_code)) %>%
distinct(ref_num, study_objective) %>%
print()
## ---- 4. Comptage (une étude = un ref_num, compté une seule fois) -----------
topic <- dataset_unique %>%
filter(!is.na(topic_code)) %>%
distinct(ref_num, topic_code) %>%
count(topic_code, name = "n") %>%
left_join(topic_levels, by = "topic_code") %>%
mutate(
percent     = 100 * n / sum(n),
label       = paste0(n, " (", round(percent, 1), "%)"),
study_topic = str_wrap(topic_label, width = 40)
) %>%
arrange(desc(n))
## ---- 5. Figure (même format que ton code, + couleur par groupe) -----------
topic_plot <- ggplot(topic, aes(x = fct_reorder(study_topic, n), y = n, fill = group)) +
geom_col(width = 0.75) +
geom_text(
aes(label = label),
hjust = -0.1,
size = 3.5
) +
coord_flip() +
scale_fill_manual(values = c("Methodological" = "#2C7FB8",
"Ecological / applied" = "grey60")) +
scale_y_continuous(
expand = expansion(mult = c(0, 0.35))
) +
labs(
x = NULL,
y = "Number of studies",
fill = NULL
) +
publication_theme +
theme(
plot.title = element_text(face = "bold", size = 14),
plot.subtitle = element_text(size = 11),
axis.text.y = element_text(size = 10),
axis.text.x = element_text(size = 10),
axis.title.x = element_text(size = 11),
legend.position = "bottom",
plot.margin = margin(10, 40, 10, 10)
)
topic_plot
View(topic)
View(dataset_unique)
